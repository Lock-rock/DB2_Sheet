Check index list on table :

SELECT INDNAME       AS INDEX_NAME,
       INDSCHEMA     AS INDEX_SCHEMA,
       UNIQUERULE    AS UNIQUENESS,
       COLNAMES      AS INDEX_COLUMNS,
       INDEXTYPE     AS INDEX_TYPE
FROM SYSCAT.INDEXES
WHERE TABNAME   = 'YOUR_TABLE_NAME'
  AND TABSCHEMA = 'YOUR_SCHEMA_NAME'
ORDER BY INDEX_NAME;
